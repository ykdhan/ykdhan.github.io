# Copy to apps/server/.env for local development (gitignored).

# Postgres with the pgvector extension (Railway: use the pgvector template).
DATABASE_URL=postgres://postgres@localhost:5432/yk

# Claude API key for the chat. Model defaults to claude-haiku-5-5.
ANTHROPIC_API_KEY=
# CHAT_MODEL=claude-haiku-5-5

# Slack Incoming Webhook: unanswered questions, contact requests, collaboration proposals.
SLACK_WEBHOOK_URL=

# Admin panel login. SESSION_SECRET must be 32+ random characters (openssl rand -hex 32).
ADMIN_PASSWORD=
SESSION_SECRET=

# Origins allowed to call the API (landing + admin), comma separated.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Embeddings for memory search: local (free, in-process) | voyage | none
EMBEDDER=local
# VOYAGE_API_KEY=

# Optional: raises GitHub API limits for repository import.
# GITHUB_TOKEN=

# Optional limits
# CHAT_LIMIT_PER_MINUTE=6
# CHAT_LIMIT_PER_DAY=60
# CHAT_LIMIT_GLOBAL_PER_DAY=3000
# MESSAGE_LIMIT_PER_DAY=5
