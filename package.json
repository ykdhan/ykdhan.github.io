{
  "name": "yk",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:landing": "npm run dev -w @yk/landing",
    "dev:admin": "npm run dev -w @yk/admin",
    "dev:server": "npm run dev -w @yk/server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
